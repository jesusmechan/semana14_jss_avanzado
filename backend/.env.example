# Copia este archivo como .env y cambia los valores. El archivo .env no se sube al repositorio.
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
# Clave para firmar los tokens de sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=reemplaza-esta-clave-por-una-aleatoria
TOKEN_DURACION_HORAS=168

# Mercado Pago (entorno de prueba). Obtén las claves en:
# https://www.mercadopago.com.pe/developers/es → Tus integraciones → Pruebas → Credenciales de prueba
# Public Key: formato UUID (APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# Access Token: cadena larga. Nunca la pongas en el frontend.
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-reemplaza-por-tu-access-token-de-prueba
